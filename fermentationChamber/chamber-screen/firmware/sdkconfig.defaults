# --- Flash / partitioning -------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM ----------------------------------------------------------------
# The stock firmware enables PSRAM and prefers it for WiFi/LWIP buffers, and
# GPIO16/17 are consumed by it on WROVER modules.
#
# IGNORE_NOTFOUND matters: without it, a board that has no PSRAM aborts during
# early init, before the app produces a single log line — indistinguishable
# from a dead board. With it, the module is simply used when present.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# --- Console --------------------------------------------------------------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- Bluetooth ------------------------------------------------------------
# NimBLE, matching stock, for RAPT Pill / RAPT Temp scanning. Observer role
# only: the Pill broadcasts, we never connect.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# A passive observer never connects, bonds, or resolves private addresses.
# Leaving host-based privacy on pulls in ble_hs_resolv, which then wants
# ble_sm_alg_encrypt from the security manager the roles above just removed -
# an link error rather than a config error, so it is worth stating explicitly.
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# --- OTA / rollback -------------------------------------------------------
# The single most useful setting here for development. An OTA image boots in
# PENDING_VERIFY; if it reboots without calling
# esp_ota_mark_app_valid_cancel_rollback(), the bootloader reverts to the
# previous slot. A broken push therefore costs a reboot, not a bench trip.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- HTTP server ----------------------------------------------------------
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- Misc -----------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_TASK_WDT_EN=y

# --- LVGL ------------------------------------------------------------------
# Built-in Montserrat sizes the panel UI uses. The design calls for an 80px
# numeral; LVGL ships nothing above 48, so that one needs lv_font_conv later.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_PERF_MONITOR=n

# --- LVGL trimming ---------------------------------------------------------
# LVGL 9.5 builds its test harness, monkey tester, sysmon and ThorVG shims by
# default, which pushed the app past the 1536 KB OTA slot. The partition
# layout is fixed to match stock, so the app has to fit - trim LVGL instead.
CONFIG_LV_USE_TEST=n
CONFIG_LV_USE_MONKEY=n
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PROFILER=n
CONFIG_LV_USE_MEM_MONITOR=n
CONFIG_LV_USE_REFR_DEBUG=n
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_VG_LITE_THORVG=n
CONFIG_LV_USE_DRAW_DMA2D=n
CONFIG_LV_USE_OBJ_ID_BUILTIN=n
CONFIG_LV_USE_OBJ_PROPERTY=n

# Widgets the panel does not use. Chart stays - the history screen needs it.
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_IMGBTN=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_LOTTIE=n
CONFIG_LV_USE_FFMPEG=n
CONFIG_LV_USE_RLOTTIE=n
CONFIG_LV_USE_QRCODE=n
CONFIG_LV_USE_BARCODE=n
CONFIG_LV_USE_GIF=n
CONFIG_LV_USE_BMP=n
CONFIG_LV_USE_TJPGD=n
CONFIG_LV_USE_LODEPNG=n
CONFIG_LV_USE_LIBPNG=n
CONFIG_LV_USE_LIBJPEG_TURBO=n
CONFIG_LV_USE_FREETYPE=n
CONFIG_LV_USE_TINY_TTF=n
CONFIG_LV_USE_FS_STDIO=n
CONFIG_LV_USE_FS_POSIX=n
CONFIG_LV_USE_FS_FATFS=n
CONFIG_LV_USE_FS_LITTLEFS=n
CONFIG_LV_USE_SNAPSHOT=n
CONFIG_LV_USE_IME_PINYIN=n
CONFIG_LV_USE_FRAGMENT=n
CONFIG_LV_USE_IMGFONT=n
CONFIG_LV_USE_OBSERVER=n
CONFIG_LV_USE_XML=n

# Fonts: only the sizes the panel uses.
CONFIG_LV_FONT_MONTSERRAT_8=n
CONFIG_LV_FONT_MONTSERRAT_10=n
CONFIG_LV_FONT_MONTSERRAT_12=n
CONFIG_LV_FONT_MONTSERRAT_18=n
CONFIG_LV_FONT_MONTSERRAT_22=n
CONFIG_LV_FONT_MONTSERRAT_24=n
CONFIG_LV_FONT_MONTSERRAT_26=n
CONFIG_LV_FONT_MONTSERRAT_30=n
CONFIG_LV_FONT_MONTSERRAT_32=n
CONFIG_LV_FONT_MONTSERRAT_34=n
CONFIG_LV_FONT_MONTSERRAT_36=n
CONFIG_LV_FONT_MONTSERRAT_38=n
CONFIG_LV_FONT_MONTSERRAT_40=n
CONFIG_LV_FONT_MONTSERRAT_42=n
CONFIG_LV_FONT_MONTSERRAT_44=n
CONFIG_LV_FONT_MONTSERRAT_46=n

# LVGL's bundled examples and demos reference widgets disabled above, so they
# must go too - they are not wanted in a shipped image regardless.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
